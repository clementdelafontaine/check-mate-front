# Copy to .env on the server (never commit .env).

# PostgreSQL
POSTGRES_PASSWORD=change-me

# Optional: allowed origin for the API (leave empty for same-origin via NPM)
CORS_ORIGIN=

# CasaOS: where the postgres data lives (backup-friendly bind mount)
CHECKMATE_DATA_DIR=/DATA/AppData/checkmate

# Docker network of your Nginx Proxy Manager (docker network ls on the server)
NPM_NETWORK=nginx-proxy-manager_default

# Copy to .env on the server (never commit .env).
# Read by docker compose next to docker-compose.yml.

# PostgreSQL password (used by postgres and the API connection string)
POSTGRES_PASSWORD=change-me

# Optional: allowed origin for the API (leave empty for same-origin via npmplus)
CORS_ORIGIN=

# Initial admin account, created at API startup if missing
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-8chars

# Cookie security: set to true once served over HTTPS
COOKIE_SECURE=true
